{
  "manifest_version": 3,
  "name": "docode — Developer Mode for Google Docs",
  "version": "0.4.0",
  "description": "Live, editable code blocks for Google Docs.",
  "permissions": ["storage", "clipboardRead", "clipboardWrite"],
  "host_permissions": ["https://docs.google.com/document/*"],
  "background": {
    "service_worker": "src/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": ["src/languages.js", "src/language-detector.js", "src/highlighter.js", "src/editor-model.js", "src/block-registry.js", "src/docs-adapter.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Open or edit a docode code block"
  },
  "commands": {
    "open-code-editor": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Option+Shift+C"
      },
      "description": "Open or edit a docode code block"
    }
  }
}
